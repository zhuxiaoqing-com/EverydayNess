<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" shutdownHook="disable" >
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level  [%X{service}] [%t] %c - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="CORE" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="CORE_CONN" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="CORE_DB" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="CORE_MSG" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="CORE_REMOTE" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="CORE_EFFECT" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="TEMP" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="ERROR" level="error" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="STATISTICS" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="CONFIG" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="HIT_LOG" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
